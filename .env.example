# ==============================================================================
# VEDANTVERSE PORTFOLIO: CRM & NOTIFICATION SYSTEM CONFIGURATION
# Copy this file to `.env.local` to enable live phone alerts & email dispatch.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ADMIN SECURITY
# ------------------------------------------------------------------------------
# PIN code used to access /admin/crm and /admin/analytics (Default: 8520)
ADMIN_PIN=8520

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT (RECOMMENDED: 100% Free Instant Phone Notification)
# ------------------------------------------------------------------------------
# Steps to set up in 2 minutes:
# 1. Open Telegram on your phone or PC and search for "@BotFather".
# 2. Send `/newbot`, give it a name (e.g. "Vedant Lead Alerts"), and copy the BOT TOKEN.
# 3. Search for "@userinfobot" on Telegram and press Start to get your numeric CHAT ID.
# 4. Open your new bot and click "START" so it has permission to message you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 3. EMAIL NOTIFICATIONS (via Resend - 3,000 free emails/month)
# ------------------------------------------------------------------------------
# Steps to set up:
# 1. Create a free account at https://resend.com
# 2. Generate an API Key under "API Keys" -> paste below.
# 3. Put your personal email address where you want to receive lead alerts.
RESEND_API_KEY=
NOTIFICATION_EMAIL=
# Optional: if you have a verified domain on Resend (e.g. "Vedant <leads@yourdomain.com>")
# Defaults to: "VedantVerse CRM <onboarding@resend.dev>"
RESEND_FROM_EMAIL=

# ------------------------------------------------------------------------------
# 4. NTFY.SH PUSH NOTIFICATIONS (ZERO SETUP: Instant Native Phone Push)
# ------------------------------------------------------------------------------
# Steps to set up in 30 seconds:
# 1. Install the free "ntfy" app on your iPhone (App Store) or Android (Play Store).
# 2. Choose a secret topic name (e.g. "vedant-leads-secret-9823") and subscribe in the app.
# 3. Paste the exact same topic name below:
NTFY_TOPIC=

# ------------------------------------------------------------------------------
# 5. DISCORD WEBHOOK (Optional Instant Mobile Push)
# ------------------------------------------------------------------------------
# Steps to set up:
# 1. In your Discord server -> Edit Channel -> Integrations -> Create Webhook.
# 2. Copy Webhook URL and paste below:
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 6. OPTIONAL: VERCEL KV / UPSTASH REDIS (For cloud inquiries & analytics storage)
# ------------------------------------------------------------------------------
# If left empty, inquiries will be stored in local `inquiries.json` automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
